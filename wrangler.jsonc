{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sodops-uz",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d38d114c333f4a438406b3d43edf6c3b",
    },
  ],
  "vars": {
    "SITE_URL": "https://sodops.uz",
    "ADMIN_EMAIL": "me@sodops.uz",
  },
}
