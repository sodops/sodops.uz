{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sodops-uz",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sodops-db",
      "database_id": "preview-sodops-db",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sodops-images",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "SITE_URL": "https://sodops.uz",
    "ADMIN_EMAIL": "me@sodops.uz",
  },
}
