{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sodops-uz",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },

  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "fd0811aa79974bef8f3ff12fd6e45752",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sodops-db",
      "database_id": "35a11a8f-8072-470b-ad1d-8402beb7f339",
    },
  ],
  // Uncomment once R2 is enabled in Cloudflare dashboard and bucket 'sodops-uploads' is created:
  // "r2_buckets": [
  //   {
  //     "binding": "UPLOADS_BUCKET",
  //     "bucket_name": "sodops-uploads",
  //   },
  // ],
  "vars": {
    "SITE_URL": "https://sodops.uz",
    "ADMIN_EMAIL": "me@sodops.uz",
  },
}
