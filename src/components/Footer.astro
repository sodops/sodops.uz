---
import { strings } from '../lib/strings';

const currentYear = new Date().getFullYear();
---

<footer
  class="w-full mt-auto py-10 border-t border-neutral-200/60 dark:border-neutral-800/60"
>
  <div
    class="max-w-[720px] mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-600 dark:text-neutral-400"
  >
    <div class="flex items-center gap-3">
      <span>{strings.site.author} &copy; {currentYear}</span>
      <span aria-hidden="true">&middot;</span>
      <span>{strings.footer.license}</span>
    </div>

    <div class="flex items-center gap-4">
      <!-- Obfuscated email against scrapers: rendered dynamically or using html entities -->
      <a
        id="contact-email"
        href="#"
        data-user="me"
        data-domain="sodops.uz"
        class="hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-500 rounded"
      >
        <span class="email-placeholder">me [at] sodops.uz</span>
      </a>

      <span aria-hidden="true">&middot;</span>

      <a
        href="/feed.xml"
        class="hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-500 rounded"
      >
        {strings.nav.rss}
      </a>
    </div>
  </div>
</footer>
