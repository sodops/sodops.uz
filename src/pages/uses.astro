---
import BaseLayout from '../layouts/BaseLayout.astro';
import { strings } from '../lib/strings';

export const prerender = false;

// Edge cache tags: 1h TTL, 1d stale-while-revalidate, tagged with 'pages'
Astro.cache.set({
  maxAge: 3600,
  swr: 86400,
  tags: ['pages'],
});

const categories = [
  {
    title: 'Hardware & Workstation',
    items: [
      {
        name: 'Workstation Laptop',
        description: 'TODO(sodiq): Specify workstation hardware and specs.',
      },
      {
        name: 'Display & Peripherals',
        description: 'TODO(sodiq): Specify monitors, keyboard, and peripherals.',
      },
    ],
  },
  {
    title: 'Operating System & Terminal',
    items: [
      {
        name: 'Operating System',
        description: 'TODO(sodiq): Specify Linux distribution and window environment.',
      },
      {
        name: 'Terminal & Shell',
        description: 'TODO(sodiq): Specify shell, terminal emulator, and multiplexer.',
      },
      {
        name: 'CLI Utilities',
        description: 'TODO(sodiq): Specify core CLI utilities and daily workflow tools.',
      },
    ],
  },
  {
    title: 'DevOps & Infrastructure Stack',
    items: [
      {
        name: 'Containers & Orchestration',
        description: 'Docker and Kubernetes (k3s).',
      },
      {
        name: 'Observability & Monitoring',
        description: 'Prometheus, Grafana, and Loki.',
      },
      {
        name: 'Cloud & Edge Providers',
        description: 'Cloudflare and DigitalOcean.',
      },
    ],
  },
  {
    title: 'Development & Tools',
    items: [
      {
        name: 'Editor',
        description: 'TODO(sodiq): Specify primary editor, IDE, and keybindings.',
      },
      {
        name: 'Languages & Environment',
        description: 'TODO(sodiq): Specify languages and runtimes.',
      },
    ],
  },
];
---

<BaseLayout
  title={strings.uses.title}
  description={strings.uses.description}
>
  <div class="space-y-8">
    <header class="space-y-2">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 font-sans">
        {strings.uses.title}
      </h1>
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 font-sans">
        {strings.uses.description}
      </p>
    </header>

    <div class="space-y-10 pt-2">
      {categories.map((category) => (
        <section class="space-y-4">
          <h2 class="text-sm font-semibold tracking-wider uppercase text-neutral-600 dark:text-neutral-400 font-mono">
            {category.title}
          </h2>
          <div class="grid grid-cols-1 gap-3">
            {category.items.map((item) => (
              <div class="p-4 rounded-lg border border-neutral-200/70 dark:border-neutral-800/70 bg-white/40 dark:bg-neutral-900/30 space-y-1">
                <div class="text-sm font-medium text-neutral-900 dark:text-neutral-100 font-sans">
                  {item.name}
                </div>
                <div class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-sans">
                  {item.description}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
