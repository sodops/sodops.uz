---
import BaseLayout from '../layouts/BaseLayout.astro';
import { strings } from '../lib/strings';

import { getCollection } from 'astro:content';

// Required: On-demand rendering with Cloudflare edge caching
export const prerender = false;

// Use Astro route cache (cacheCloudflare provider) instead of raw Cache-Control.
// Allows Phase 3 admin to call Astro.cache.invalidate({ tags: ['blog', 'home'] })
// for instant CDN purge on post save. routeRules in astro.config.mjs seeds the
// defaults; this call adds the home-specific tag and can override maxAge per request.
Astro.cache.set({ maxAge: 60, swr: 300, tags: ['home', 'blog'] });

// Temporary: X-Rendered-At header proves CDN cache hits.
// Two requests within 60s should return the same timestamp value.
// Remove this header once caching is confirmed working.
Astro.response.headers.set('X-Rendered-At', new Date().toISOString());

import { getPublishedPosts, getFeaturedProjects } from '../lib/db';

import { env } from 'cloudflare:workers';

// Load latest 3 published posts from D1 database (fallback to collection)
let recentPosts: Array<{
  slug: string;
  title: string;
  published_at: Date;
  excerpt: string;
}> = [];

if (env?.DB) {
  const d1Posts = await getPublishedPosts(env.DB);
  if (d1Posts.length > 0) {
    recentPosts = d1Posts.slice(0, 3).map((p) => ({
      slug: p.slug,
      title: p.title,
      published_at: new Date(p.published_at || p.created_at),
      excerpt: p.excerpt,
    }));
  }
}

if (recentPosts.length === 0) {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);
  recentPosts = allPosts
    .sort((a, b) => b.data.published_at.getTime() - a.data.published_at.getTime())
    .slice(0, 3)
    .map((p) => ({
      slug: p.data.slug,
      title: p.data.title,
      published_at: p.data.published_at,
      excerpt: p.data.excerpt,
    }));
}

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}

const dbFeatured = env?.DB ? await getFeaturedProjects(env.DB) : [];
const featuredProjects =
  dbFeatured.length > 0
    ? dbFeatured
    : [
        {
          name: 'sodops.uz',
          description:
            'Personal publishing platform, minimal blog, and edge status monitor built on Astro & Cloudflare Workers.',
          url: 'https://sodops.uz',
          tech_tags: ['Astro', 'Cloudflare D1', 'Tailwind CSS'],
          current_status: 'up' as const,
        },
        {
          name: 'mc.sodops.uz',
          description:
            'Minecraft server status & web gateway.',
          url: 'https://mc.sodops.uz',
          tech_tags: ['Infrastructure', 'Self-Hosted'],
          current_status: 'unknown' as const,
        },
      ];
---

<BaseLayout title={strings.site.title}>
  <!-- Intro Prose Section -->
  <section
    class="space-y-5 text-neutral-800 dark:text-neutral-200 leading-relaxed text-[15px] sm:text-base"
  >
    <h1
      class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-sans"
    >
      {strings.home.greeting}
    </h1>

    <p>
      I'm a DevOps-oriented developer and AI student based in
      <span class="text-neutral-900 dark:text-neutral-100 font-medium"
        >{strings.site.location}</span
      >. I build and maintain infrastructure using
      <a
        href="https://www.docker.com"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-emerald-700 dark:text-emerald-400 underline underline-offset-2 decoration-emerald-500/40 hover:decoration-emerald-500"
        >Docker</a
      >,
      <a
        href="https://k3s.io"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-emerald-700 dark:text-emerald-400 underline underline-offset-2 decoration-emerald-500/40 hover:decoration-emerald-500"
        >Kubernetes (k3s)</a
      >,
      <a
        href="https://prometheus.io"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-emerald-700 dark:text-emerald-400 underline underline-offset-2 decoration-emerald-500/40 hover:decoration-emerald-500"
        >Prometheus</a
      >,
      <a
        href="https://grafana.com"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-emerald-700 dark:text-emerald-400 underline underline-offset-2 decoration-emerald-500/40 hover:decoration-emerald-500"
        >Grafana</a
      >, and
      <a
        href="https://grafana.com/oss/loki/"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-emerald-700 dark:text-emerald-400 underline underline-offset-2 decoration-emerald-500/40 hover:decoration-emerald-500"
        >Loki</a
      >.
    </p>

    <p>
      My work focuses on cloud & edge deployments across
      <a
        href="https://cloudflare.com"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-emerald-700 dark:text-emerald-400 underline underline-offset-2 decoration-emerald-500/40 hover:decoration-emerald-500"
        >Cloudflare</a
      > and
      <a
        href="https://digitalocean.com"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-emerald-700 dark:text-emerald-400 underline underline-offset-2 decoration-emerald-500/40 hover:decoration-emerald-500"
        >DigitalOcean</a
      >, pairing resilient distributed architectures with minimal, fast frontend delivery.
    </p>

    <!-- "What I'm Doing Now" Callout -->
    <div
      class="pt-2 text-sm text-neutral-600 dark:text-neutral-400 flex items-center gap-2"
    >
      <span
        class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
        aria-hidden="true"></span>
      <span>
        {strings.home.nowTeaser}
        <a
          href="/now"
          class="text-emerald-700 dark:text-emerald-400 font-medium hover:underline ml-1"
        >
          {strings.home.nowLinkText} &rarr;
        </a>
      </span>
    </div>
  </section>

  <!-- Divider -->
  <hr class="my-10 border-neutral-200/60 dark:border-neutral-800/60" />

  <!-- Recent Writing -->
  <section class="space-y-6">
    <div class="flex items-center justify-between">
      <h2
        class="text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
      >
        {strings.home.latestPosts}
      </h2>
      <a
        href="/blog"
        class="text-xs font-medium text-emerald-700 dark:text-emerald-400 hover:underline"
      >
        {strings.home.allPosts} &rarr;
      </a>
    </div>

    <div class="space-y-4">
      {
        recentPosts.map((post) => (
          <article class="group relative flex flex-col space-y-1">
            <div class="flex items-baseline justify-between gap-4">
              <a
                href={`/blog/${post.slug}`}
                class="text-[15px] font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors"
              >
                {post.title}
              </a>
              <span class="text-xs font-mono text-neutral-600 dark:text-neutral-400 shrink-0">
                {formatDate(post.published_at)}
              </span>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2">
              {post.excerpt}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Divider -->
  <hr class="my-10 border-neutral-200/60 dark:border-neutral-800/60" />

  <!-- Featured Projects -->
  <section class="space-y-6">
    <div class="flex items-center justify-between">
      <h2
        class="text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
      >
        {strings.home.featuredProjects}
      </h2>
      <a
        href="/projects"
        class="text-xs font-medium text-emerald-700 dark:text-emerald-400 hover:underline"
      >
        {strings.home.allProjects} &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {
        featuredProjects.map((project) => (
          <a
            href={project.url}
            target={project.url.startsWith('http') ? '_blank' : undefined}
            rel="noopener noreferrer"
            class="block p-4 rounded border border-neutral-200/70 dark:border-neutral-800/70 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 bg-white/50 dark:bg-neutral-900/40 transition-colors group"
          >
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <span class="font-medium text-sm text-neutral-900 dark:text-neutral-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {project.name}
              </span>
              <span
                class:list={[
                  'inline-flex items-center gap-1 text-[11px] font-mono',
                  project.current_status === 'up'
                    ? 'text-emerald-700 dark:text-emerald-400'
                    : project.current_status === 'degraded'
                      ? 'text-amber-700 dark:text-amber-400'
                      : project.current_status === 'down'
                        ? 'text-red-700 dark:text-red-400'
                        : project.current_status === 'paused'
                          ? 'text-neutral-600 dark:text-neutral-400'
                          : 'text-neutral-500',
                ]}
              >
                <span
                  class:list={[
                    'w-1.5 h-1.5 rounded-full',
                    project.current_status === 'up'
                      ? 'bg-emerald-500'
                      : project.current_status === 'degraded'
                        ? 'bg-amber-500'
                        : project.current_status === 'down'
                          ? 'bg-red-500'
                          : 'bg-neutral-400',
                  ]}
                />
                <span>{project.current_status === 'paused' ? 'coming soon' : project.current_status}</span>
              </span>
            </div>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 line-clamp-2 mb-3">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {(project.tech_tags || []).map((tag) => (
                <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
