---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { authenticateAdminRequest } from '../../lib/auth';
import { getAllPosts } from '../../lib/db';

import { env } from 'cloudflare:workers';

export const prerender = false;

const auth = (Astro.locals as any)?.auth || await authenticateAdminRequest({
  isDev: import.meta.env.DEV,
  host: Astro.request.headers.get('host'),
  jwtAssertion: Astro.request.headers.get('Cf-Access-Jwt-Assertion'),
  adminEmails: env.ADMIN_EMAILS || env.ADMIN_EMAIL,
  expectedAud: env.CF_ACCESS_AUD,
  teamDomain: env.CF_ACCESS_TEAM_DOMAIN,
  devBypassAuth: env.DEV_BYPASS_AUTH === 'true' || import.meta.env.DEV,
});

const isAuthenticated = auth.authenticated;
if (!isAuthenticated) {
  Astro.response.status = 401;
}
const initialPosts = isAuthenticated && env.DB ? await getAllPosts(env.DB) : [];
---

<BaseLayout
  title="Admin Publishing Panel"
  description="Manage and publish posts for sodops.uz"
>
  {
    !isAuthenticated ? (
      <div class="py-16 text-center space-y-4">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-red-100 dark:bg-red-950/50 text-red-600 dark:text-red-400 mb-2 font-mono text-xl">
          !
        </div>
        <h1 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-sans">
          Cloudflare Access Authentication Required
        </h1>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 max-w-md mx-auto">
          Access to this route requires verified Cloudflare Access credentials.
        </p>
        <div class="pt-4">
          <a
            href="/"
            class="text-xs font-mono text-emerald-600 dark:text-emerald-400 hover:underline"
          >
            &larr; Return to public homepage
          </a>
        </div>
      </div>
    ) : (
      <div id="admin-app" class="space-y-6">
        {/* Top Toolbar */}
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-neutral-200/60 dark:border-neutral-800/60">
          <div>
            <h1 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
              Admin Dashboard
            </h1>
            <p class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mt-0.5">
              Logged in as{' '}
              <span class="text-emerald-600 dark:text-emerald-400 font-medium">
                {auth.email}
              </span>
            </p>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              id="new-post-btn"
              class="px-3 py-1.5 text-xs font-medium rounded bg-emerald-600 hover:bg-emerald-500 text-white dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:text-neutral-950 transition-colors cursor-pointer"
            >
              + New Post
            </button>
            <a
              href="/api/admin/export"
              class="px-2.5 py-1.5 text-xs font-mono rounded border border-neutral-200 dark:border-neutral-800 hover:border-emerald-500/60 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
            >
              Export JSON
            </a>
          </div>
        </div>

        {/* Notification Toast */}
        <div
          id="admin-alert"
          class="hidden px-4 py-2.5 text-xs rounded border transition-all"
        />

        {/* View 1: Posts List */}
        <section id="posts-list-view" class="space-y-4">
          <div class="flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-neutral-400">
            <span>
              All Posts (<span id="post-count">{initialPosts.length}</span>)
            </span>
            <span class="text-[11px]">Instant publishing enabled</span>
          </div>

          <div id="posts-table-container" class="space-y-2">
            {initialPosts.length === 0 ? (
              <p class="py-8 text-center text-xs text-neutral-500 dark:text-neutral-400">
                No posts found in database. Create your first post using the button above.
              </p>
            ) : (
              initialPosts.map((post) => (
                <div class="p-3.5 rounded border border-neutral-200/60 dark:border-neutral-800/60 bg-white/40 dark:bg-neutral-900/40 hover:border-emerald-500/40 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div class="space-y-1 min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                      <span
                        class:list={[
                          'text-[10px] font-mono uppercase px-1.5 py-0.5 rounded',
                          post.published
                            ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300'
                            : 'bg-neutral-200 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-400',
                        ]}
                      >
                        {post.published ? 'Published' : 'Draft'}
                      </span>
                      <a
                        href={`/blog/${post.slug}`}
                        target="_blank"
                        class="text-sm font-medium text-neutral-900 dark:text-neutral-100 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors truncate"
                      >
                        {post.title}
                      </a>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 dark:text-neutral-500">
                      <span>/{post.slug}</span>
                      <span>&middot;</span>
                      <span>{post.reading_time_minutes} min</span>
                      <span>&middot;</span>
                      <span>
                        {post.published_at ? post.published_at.split('T')[0] : 'Not set'}
                      </span>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 shrink-0">
                    <button
                      type="button"
                      class="edit-post-btn px-2.5 py-1 text-xs font-mono rounded border border-neutral-200 dark:border-neutral-800 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors cursor-pointer"
                      data-id={post.id}
                      data-title={post.title}
                      data-slug={post.slug}
                      data-content={post.content}
                      data-excerpt={post.excerpt}
                      data-tags={post.tags.join(', ')}
                      data-published={post.published ? 'true' : 'false'}
                    >
                      Edit
                    </button>
                    <button
                      type="button"
                      class="delete-post-btn px-2.5 py-1 text-xs font-mono rounded border border-neutral-200 dark:border-neutral-800 hover:border-red-500/50 hover:text-red-600 dark:hover:text-red-400 transition-colors cursor-pointer"
                      data-id={post.id}
                      data-title={post.title}
                    >
                      Delete
                    </button>
                  </div>
                </div>
              ))
            )}
          </div>
        </section>

        {/* View 2: Post Editor (Hidden by default) */}
        <section id="post-editor-view" class="hidden space-y-6">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-200/60 dark:border-neutral-800/60">
            <h2
              id="editor-heading"
              class="text-base font-semibold text-neutral-900 dark:text-neutral-100"
            >
              Create New Post
            </h2>
            <button
              type="button"
              id="cancel-editor-btn"
              class="text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors cursor-pointer"
            >
              &larr; Back to posts list
            </button>
          </div>

          <form id="post-form" class="space-y-4">
            <input type="hidden" id="post-id" name="id" value="" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label
                  for="post-title"
                  class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
                >
                  Post Title *
                </label>
                <input
                  type="text"
                  id="post-title"
                  name="title"
                  required
                  placeholder="e.g. Observability on Edge Nodes"
                  class="w-full px-3 py-1.5 text-sm rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-1 focus:ring-emerald-500"
                />
              </div>

              <div class="space-y-1">
                <label
                  for="post-slug"
                  class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
                >
                  Slug (URL) *
                </label>
                <input
                  type="text"
                  id="post-slug"
                  name="slug"
                  required
                  placeholder="observability-on-edge-nodes"
                  class="w-full px-3 py-1.5 text-sm rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 font-mono text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label
                  for="post-tags"
                  class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
                >
                  Tags (comma-separated)
                </label>
                <input
                  type="text"
                  id="post-tags"
                  name="tags"
                  placeholder="k3s, devops, prometheus"
                  class="w-full px-3 py-1.5 text-sm rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 text-xs font-mono focus:outline-none focus:ring-1 focus:ring-emerald-500"
                />
              </div>

              <div class="space-y-1">
                <label
                  for="post-excerpt"
                  class="block text-xs font-mono text-neutral-500 dark:text-neutral-400"
                >
                  Short Excerpt
                </label>
                <input
                  type="text"
                  id="post-excerpt"
                  name="excerpt"
                  placeholder="A concise summary of the post..."
                  class="w-full px-3 py-1.5 text-sm rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500"
                />
              </div>
            </div>

            {/* Published Checkbox */}
            <div class="flex items-center gap-2 pt-1">
              <input
                type="checkbox"
                id="post-published"
                name="published"
                class="rounded border-neutral-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer"
              />
              <label
                for="post-published"
                class="text-xs font-medium text-neutral-800 dark:text-neutral-200 cursor-pointer"
              >
                Publish immediately (renders HTML, purges edge cache tags)
              </label>
            </div>

            {/* Split Markdown Editor */}
            <div class="space-y-2 pt-2">
              <div class="flex items-center justify-between text-xs font-mono text-neutral-400">
                <span>
                  Markdown Editor (Paste or drag images to upload directly to R2)
                </span>
                <span id="upload-status" class="text-emerald-600 dark:text-emerald-400" />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 h-[420px]">
                {/* Raw Editor */}
                <textarea
                  id="post-content"
                  name="content"
                  required
                  placeholder="Write your Markdown post here... Paste images directly or drop them."
                  class="w-full h-full p-3 text-xs font-mono rounded border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 resize-none focus:outline-none focus:ring-1 focus:ring-emerald-500 leading-relaxed"
                />

                {/* Live Preview Pane */}
                <div
                  id="post-preview"
                  class="w-full h-full p-4 overflow-y-auto rounded border border-neutral-200/60 dark:border-neutral-800/60 bg-neutral-100/30 dark:bg-neutral-900/30 prose prose-neutral dark:prose-invert max-w-none text-xs leading-relaxed"
                >
                  <p class="text-neutral-400">Live preview will render here...</p>
                </div>
              </div>
            </div>

            {/* Form Actions */}
            <div class="flex items-center justify-between pt-4 border-t border-neutral-200/60 dark:border-neutral-800/60">
              <button
                type="button"
                id="delete-current-btn"
                class="hidden px-3 py-1.5 text-xs font-mono rounded border border-red-300 dark:border-red-900 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/40 transition-colors cursor-pointer"
              >
                Delete Post
              </button>

              <div class="flex items-center gap-3 ml-auto">
                <button
                  type="button"
                  id="cancel-btn-bottom"
                  class="px-3 py-1.5 text-xs font-mono rounded border border-neutral-300 dark:border-neutral-700 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  id="save-post-btn"
                  class="px-4 py-1.5 text-xs font-medium rounded bg-emerald-600 hover:bg-emerald-500 text-white dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:text-neutral-950 transition-colors cursor-pointer"
                >
                  Save Post
                </button>
              </div>
            </div>
          </form>
        </section>
      </div>
    )
  }

  {/* Admin App Client Script */}
  <script is:inline>
    (function () {
      if (!document.getElementById('admin-app')) return;
      const listView = document.getElementById('posts-list-view');
      const editorView = document.getElementById('post-editor-view');
      const newPostBtn = document.getElementById('new-post-btn');
      const cancelTop = document.getElementById('cancel-editor-btn');
      const cancelBottom = document.getElementById('cancel-btn-bottom');
      const postForm = document.getElementById('post-form');
      const heading = document.getElementById('editor-heading');
      const alertBox = document.getElementById('admin-alert');
      const deleteCurrentBtn = document.getElementById('delete-current-btn');

      const inputId = document.getElementById('post-id');
      const inputTitle = document.getElementById('post-title');
      const inputSlug = document.getElementById('post-slug');
      const inputExcerpt = document.getElementById('post-excerpt');
      const inputTags = document.getElementById('post-tags');
      const inputPublished = document.getElementById('post-published');
      const inputContent = document.getElementById('post-content');
      const previewPane = document.getElementById('post-preview');
      const uploadStatus = document.getElementById('upload-status');

      function showAlert(msg, isError = false) {
        alertBox.textContent = msg;
        alertBox.className = isError
          ? 'px-4 py-2 text-xs rounded border border-red-300 bg-red-50 text-red-700 dark:border-red-800 dark:bg-red-950/60 dark:text-red-300 block'
          : 'px-4 py-2 text-xs rounded border border-emerald-300 bg-emerald-50 text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 block';
        setTimeout(() => {
          alertBox.className = 'hidden';
        }, 4000);
      }

      function showEditor(editMode = false, data = {}) {
        listView.classList.add('hidden');
        editorView.classList.remove('hidden');

        if (editMode) {
          heading.textContent = `Edit Post: ${data.title}`;
          inputId.value = data.id || '';
          inputTitle.value = data.title || '';
          inputSlug.value = data.slug || '';
          inputExcerpt.value = data.excerpt || '';
          inputTags.value = data.tags || '';
          inputPublished.checked = data.published === 'true' || data.published === true;
          inputContent.value = data.content || '';
          deleteCurrentBtn.classList.remove('hidden');
        } else {
          heading.textContent = 'Create New Post';
          inputId.value = '';
          inputTitle.value = '';
          inputSlug.value = '';
          inputExcerpt.value = '';
          inputTags.value = '';
          inputPublished.checked = false;
          inputContent.value = '';
          deleteCurrentBtn.classList.add('hidden');
        }
        updatePreview();
      }

      function showList() {
        editorView.classList.add('hidden');
        listView.classList.remove('hidden');
      }

      // Auto-generate slug from title if empty
      inputTitle.addEventListener('input', () => {
        if (!inputId.value) {
          inputSlug.value = inputTitle.value
            .toLowerCase()
            .trim()
            .replace(/[^\w\s-]/g, '')
            .replace(/\s+/g, '-');
        }
      });

      // Live Preview
      function updatePreview() {
        const raw = inputContent.value;
        // Simple live render for instant client feedback
        const escaped = raw
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
        previewPane.innerHTML = `<pre class="whitespace-pre-wrap font-mono text-xs">${escaped}</pre>`;
      }
      inputContent.addEventListener('input', updatePreview);

      newPostBtn.addEventListener('click', () => showEditor(false));
      cancelTop.addEventListener('click', showList);
      cancelBottom.addEventListener('click', showList);

      // Edit button handler
      document.querySelectorAll('.edit-post-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          showEditor(true, {
            id: btn.dataset.id,
            title: btn.dataset.title,
            slug: btn.dataset.slug,
            content: btn.dataset.content,
            excerpt: btn.dataset.excerpt,
            tags: btn.dataset.tags,
            published: btn.dataset.published,
          });
        });
      });

      // Delete button handler
      async function deletePostById(id, title) {
        if (!confirm(`Are you sure you want to delete "${title}"?`)) return;
        try {
          const res = await fetch(`/api/admin/posts/${id}`, { method: 'DELETE' });
          if (!res.ok) throw new Error('Delete failed');
          showAlert(`Post "${title}" deleted.`);
          setTimeout(() => window.location.reload(), 1000);
        } catch (err) {
          showAlert(err.message, true);
        }
      }

      document.querySelectorAll('.delete-post-btn').forEach((btn) => {
        btn.addEventListener('click', () =>
          deletePostById(btn.dataset.id, btn.dataset.title)
        );
      });

      deleteCurrentBtn.addEventListener('click', () => {
        if (inputId.value) deletePostById(inputId.value, inputTitle.value);
      });

      // Form Submit: Save Post & Invalidate Edge Cache
      postForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const saveBtn = document.getElementById('save-post-btn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving & Purging CDN...';

        const contentStr = inputContent.value;
        const contentBytes = new TextEncoder().encode(contentStr).length;
        if (contentBytes > 64 * 1024) {
          showAlert(
            `Content exceeds the 64 KB limit (${Math.round(contentBytes / 1024)} KB submitted). Please shorten the post to prevent edge execution timeouts.`,
            true
          );
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Post';
          return;
        }

        const payload = {
          title: inputTitle.value,
          slug: inputSlug.value,
          content: contentStr,
          excerpt: inputExcerpt.value,
          tags: inputTags.value
            .split(',')
            .map((s) => s.trim())
            .filter(Boolean),
          published: inputPublished.checked ? 1 : 0,
        };

        const isEdit = Boolean(inputId.value);
        const url = isEdit ? `/api/admin/posts/${inputId.value}` : '/api/admin/posts';
        const method = isEdit ? 'PUT' : 'POST';

        try {
          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (!res.ok) {
            let errMsg = 'Failed to save post';
            try {
              const errData = await res.json();
              errMsg = errData.error || errMsg;
            } catch {
              if (res.status === 413) {
                errMsg = 'Post content exceeds the 64 KB limit. Please shorten your post.';
              } else if (res.status === 524 || res.status === 504) {
                errMsg = 'Server timeout while saving post (Cloudflare CPU limit exceeded).';
              } else {
                errMsg = `Server error (HTTP ${res.status})`;
              }
            }
            throw new Error(errMsg);
          }

          showAlert('Post saved successfully! Edge cache purged.');
          setTimeout(() => window.location.reload(), 1200);
        } catch (err) {
          showAlert(err.message, true);
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Post';
        }
      });

      // Image Upload (Drag-and-Drop & Paste onto textarea)
      async function uploadImageFile(file) {
        uploadStatus.textContent = 'Uploading image to R2...';
        const form = new FormData();
        form.append('file', file);

        try {
          const res = await fetch('/api/admin/upload', {
            method: 'POST',
            body: form,
          });

          if (!res.ok) {
            const data = await res.json();
            throw new Error(data.error || 'Upload failed');
          }

          const data = await res.json();
          uploadStatus.textContent = 'Upload complete!';
          setTimeout(() => (uploadStatus.textContent = ''), 2500);

          // Insert markdown image tag at cursor position
          const imgMarkdown = `\n![${file.name}](${data.url})\n`;
          const start = inputContent.selectionStart;
          const end = inputContent.selectionEnd;
          const text = inputContent.value;
          inputContent.value = text.slice(0, start) + imgMarkdown + text.slice(end);
          updatePreview();
        } catch (err) {
          uploadStatus.textContent = `Error: ${err.message}`;
        }
      }

      inputContent.addEventListener('paste', (e) => {
        const items = e.clipboardData?.items;
        if (items) {
          for (const item of items) {
            if (item.type.startsWith('image/')) {
              e.preventDefault();
              const file = item.getAsFile();
              if (file) uploadImageFile(file);
              return;
            }
          }
        }
      });

      inputContent.addEventListener('dragover', (e) => e.preventDefault());
      inputContent.addEventListener('drop', (e) => {
        e.preventDefault();
        const files = e.dataTransfer?.files;
        if (files && files.length > 0 && files[0].type.startsWith('image/')) {
          uploadImageFile(files[0]);
        }
      });
    })();
  </script>
</BaseLayout>
