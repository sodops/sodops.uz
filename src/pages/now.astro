---
import BaseLayout from '../layouts/BaseLayout.astro';
import { strings } from '../lib/strings';

export const prerender = false;
Astro.cache.set({ maxAge: 3600, swr: 86400, tags: ['pages'] });

const lastUpdated = '2026-11-08';
---

<BaseLayout title={strings.now.title} description={strings.now.description}>
  <div class="space-y-8">
    <header class="space-y-3 border-b border-neutral-200/60 dark:border-neutral-800/60 pb-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
          {strings.now.title}
        </h1>
        <time
          datetime={lastUpdated}
          class="text-xs font-mono text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800/80 px-2.5 py-1 rounded border border-neutral-200/60 dark:border-neutral-700/60"
        >
          {strings.now.updated}: {lastUpdated}
        </time>
      </div>
      <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400">
        A short snapshot of the engineering work and subjects I'm focusing on.
      </p>
    </header>

    <div class="space-y-8 text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
      <section class="space-y-3">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Engineering</h2>
        <p>
          Improving this website's publishing workflow, operational monitoring, release
          automation, and accessibility. The site runs on Astro and Cloudflare Workers.
        </p>
        <a href="/projects" class="inline-flex text-sm font-medium text-emerald-700 dark:text-emerald-400 underline underline-offset-4 hover:text-emerald-800 dark:hover:text-emerald-300">
          Explore the projects &rarr;
        </a>
      </section>

      <section class="space-y-3">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Learning &amp; practice</h2>
        <p>
          Exploring Linux, containers, CI/CD, and observability alongside AI studies.
          I share notes and technical lessons as I build.
        </p>
        <a href="/blog" class="inline-flex text-sm font-medium text-emerald-700 dark:text-emerald-400 underline underline-offset-4 hover:text-emerald-800 dark:hover:text-emerald-300">
          Read the writing &rarr;
        </a>
      </section>

      <section class="space-y-3">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Location</h2>
        <p>Based in Tashkent, Uzbekistan.</p>
      </section>
    </div>
  </div>
</BaseLayout>
