---
import BaseLayout from '../layouts/BaseLayout.astro';
import { strings } from '../lib/strings';

export const prerender = false;

// Edge cache tags: 1h TTL, 1d stale-while-revalidate, tagged with 'pages'
Astro.cache.set({
  maxAge: 3600,
  swr: 86400,
  tags: ['pages'],
});

const lastUpdated = 'TODO(sodiq)';
---

<BaseLayout
  title={strings.now.title}
  description={strings.now.description}
>
  <div class="space-y-8">
    <header class="space-y-2">
      <div class="flex items-center justify-between">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 font-sans">
          {strings.now.title}
        </h1>
        <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800/80 px-2 py-0.5 rounded border border-neutral-200/60 dark:border-neutral-700/60">
          {strings.now.updated}: {lastUpdated}
        </span>
      </div>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 font-mono">
        Now page inspired by Derek Sivers, outlining current focus and priorities.
      </p>
    </header>

    <div class="space-y-6 text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed font-sans">
      <section class="space-y-2">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 font-sans">
          Location
        </h2>
        <p>
          Based in <strong class="text-neutral-900 dark:text-neutral-100">Tashkent, Uzbekistan</strong>.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 font-sans">
          Current Focus
        </h2>
        <ul class="list-disc pl-5 space-y-1.5 text-neutral-600 dark:text-neutral-400 text-sm">
          <li>
            DevOps-oriented development with Docker, Kubernetes (k3s), Prometheus, Grafana, Loki, Cloudflare, and DigitalOcean.
          </li>
          <li>
            AI studies.
          </li>
          <li>
            TODO(sodiq): Add specific active projects and focus areas.
          </li>
        </ul>
      </section>

      <section class="space-y-2">
        <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 font-sans">
          Learning & Research
        </h2>
        <p class="text-neutral-600 dark:text-neutral-400 text-sm">
          TODO(sodiq): Specify current reading list, research papers, or courses.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
