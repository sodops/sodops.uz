---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { strings } from '../../lib/strings';
import { getPostBySlug, getPublishedPosts } from '../../lib/db';
import { extractHeadings } from '../../lib/markdown-utils';

// Required: On-demand rendering with Cloudflare edge caching
export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

import { env } from 'cloudflare:workers';

let postTitle = '';
let postExcerpt = '';
let postPublishedAt = new Date();
let postReadingTime = 1;
let postTags: string[] = [];
let contentHtml = '';
let tocHeadings: Array<{ depth: number; text: string; slug: string }> = [];
let prevPostLink: { slug: string; title: string } | null = null;
let nextPostLink: { slug: string; title: string } | null = null;

// 1. Primary: Try to fetch from D1 database
if (env?.DB) {
  const d1Post = await getPostBySlug(env.DB, slug);
  if (d1Post) {
    postTitle = d1Post.title;
    postExcerpt = d1Post.excerpt;
    postPublishedAt = new Date(d1Post.published_at || d1Post.created_at);
    postReadingTime = d1Post.reading_time_minutes;
    postTags = d1Post.tags;
    // Pre-rendered HTML served with < 0.5ms CPU, completely preventing 1102 errors
    contentHtml = d1Post.content_html;
    tocHeadings = extractHeadings(d1Post.content).filter(
      (h) => h.depth === 2 || h.depth === 3
    );

    // Prev / Next from D1
    const allD1Posts = await getPublishedPosts(env.DB);
    const idx = allD1Posts.findIndex((p) => p.slug === slug);
    if (idx > -1) {
      if (idx < allD1Posts.length - 1) {
        prevPostLink = {
          slug: allD1Posts[idx + 1].slug,
          title: allD1Posts[idx + 1].title,
        };
      }
      if (idx > 0) {
        nextPostLink = {
          slug: allD1Posts[idx - 1].slug,
          title: allD1Posts[idx - 1].title,
        };
      }
    }
  }
}

// 2. Fallback: If not in D1, check Content Collections (e.g. dev without D1)
if (!contentHtml) {
  const collectionPosts = await getCollection('posts', ({ data }) => !data.draft);
  collectionPosts.sort(
    (a, b) => b.data.published_at.getTime() - a.data.published_at.getTime()
  );
  const postIndex = collectionPosts.findIndex((p) => p.data.slug === slug);

  if (postIndex === -1) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }

  const cPost = collectionPosts[postIndex];
  postTitle = cPost.data.title;
  postExcerpt = cPost.data.excerpt;
  postPublishedAt = cPost.data.published_at;
  postReadingTime = cPost.data.reading_time_minutes;
  postTags = cPost.data.tags;

  const rendered = await render(cPost);
  tocHeadings = rendered.headings.filter((h) => h.depth === 2 || h.depth === 3);

  if (postIndex < collectionPosts.length - 1) {
    prevPostLink = {
      slug: collectionPosts[postIndex + 1].data.slug,
      title: collectionPosts[postIndex + 1].data.title,
    };
  }
  if (postIndex > 0) {
    nextPostLink = {
      slug: collectionPosts[postIndex - 1].data.slug,
      title: collectionPosts[postIndex - 1].data.title,
    };
  }
}

// Edge cache tags: group tag 'blog' plus specific post tag
Astro.cache.set({
  maxAge: 300,
  swr: 600,
  tags: ['blog', `post-${slug}`],
});

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}

const siteBase = (import.meta.env.SITE_URL || Astro.site?.toString() || 'https://sodops.uz').replace(/\/$/, '');
const postUrl = new URL(Astro.url.pathname, siteBase).toString();

// JSON-LD structured data for BlogPosting
const schemaOrgArticle = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: postTitle,
  description: postExcerpt,
  url: postUrl,
  datePublished: postPublishedAt.toISOString(),
  author: {
    '@type': 'Person',
    name: strings.site.author,
    url: siteBase,
  },
  keywords: postTags.join(', '),
};
---

<BaseLayout
  title={postTitle}
  description={postExcerpt}
  article={{
    publishedTime: postPublishedAt.toISOString(),
    tags: postTags,
  }}
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrgArticle)} />

  <article class="space-y-8">
    <!-- Back Navigation -->
    <div>
      <a
        href="/blog"
        class="inline-flex items-center text-xs font-mono text-neutral-500 dark:text-neutral-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
      >
        {strings.blog.backToBlog}
      </a>
    </div>

    <!-- Post Header -->
    <header
      class="space-y-3 pb-6 border-b border-neutral-200/60 dark:border-neutral-800/60"
    >
      <h1
        class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-sans leading-tight"
      >
        {postTitle}
      </h1>

      <div
        class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs font-mono text-neutral-500 dark:text-neutral-400"
      >
        <time datetime={postPublishedAt.toISOString()}>
          {formatDate(postPublishedAt)}
        </time>
        <span>&middot;</span>
        <span>
          {postReadingTime}
          {strings.blog.readingTime}
        </span>
        <span>&middot;</span>
        <div class="flex flex-wrap gap-1.5">
          {
            postTags.map((tag) => (
              <a
                href={`/blog?tag=${encodeURIComponent(tag)}`}
                class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >
                #{tag}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <!-- Table of Contents (if 2 or more headings exist) -->
    {
      tocHeadings.length >= 2 && (
        <nav
          aria-label="Table of contents"
          class="p-4 rounded-md border border-neutral-200/60 dark:border-neutral-800/60 bg-neutral-100/50 dark:bg-neutral-900/30 text-xs"
        >
          <div class="font-mono uppercase tracking-wider text-neutral-600 dark:text-neutral-400 mb-2 font-semibold">
            {strings.blog.tableOfContents}
          </div>
          <ul class="space-y-1.5">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? 'pl-3' : ''}>
                <a
                  href={`#${heading.slug}`}
                  class="text-neutral-600 dark:text-neutral-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors line-clamp-1"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <!-- Post Body (Pre-rendered content_html served with zero runtime Shiki overhead) -->
    <div
      class="prose prose-neutral dark:prose-invert max-w-none text-[15px] sm:text-base leading-relaxed
        prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-neutral-900 dark:prose-headings:text-neutral-100
        prose-a:text-emerald-600 dark:prose-a:text-emerald-400 prose-a:underline prose-a:underline-offset-2 prose-a:decoration-emerald-500/40 hover:prose-a:decoration-emerald-500
        prose-code:font-mono prose-code:text-[13px] prose-code:before:content-none prose-code:after:content-none
        prose-pre:bg-neutral-100 dark:prose-pre:bg-neutral-900/90 prose-pre:border prose-pre:border-neutral-200/80 dark:prose-pre:border-neutral-800"
      set:html={contentHtml}
    />

    <!-- Divider -->
    <hr class="border-neutral-200/60 dark:border-neutral-800/60" />

    <!-- Post Footer Actions: Share & Feedback -->
    <div
      class="flex items-center justify-between text-xs font-mono text-neutral-500 dark:text-neutral-400"
    >
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="share-btn"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded border border-neutral-200 dark:border-neutral-800 hover:border-emerald-500/60 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
            ></path>
          </svg>
          <span id="share-text">{strings.blog.sharePost}</span>
        </button>
      </div>

      <a
        href={`mailto:${strings.site.email}?subject=Feedback on "${postTitle}"`}
        class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
      >
        Send feedback via email &rarr;
      </a>
    </div>

    <!-- Prev / Next Post Navigation -->
    <nav
      aria-label="Previous and Next post"
      class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-neutral-200/60 dark:border-neutral-800/60"
    >
      {
        prevPostLink ? (
          <a
            href={`/blog/${prevPostLink.slug}`}
            class="p-3 rounded border border-neutral-200/60 dark:border-neutral-800/60 hover:border-emerald-500/50 transition-colors group flex flex-col justify-between"
          >
            <span class="text-[11px] font-mono text-neutral-600 dark:text-neutral-400 mb-1">
              &larr; {strings.blog.prevPost}
            </span>
            <span class="text-sm font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors line-clamp-1">
              {prevPostLink.title}
            </span>
          </a>
        ) : (
          <div />
        )
      }

      {
        nextPostLink && (
          <a
            href={`/blog/${nextPostLink.slug}`}
            class="p-3 rounded border border-neutral-200/60 dark:border-neutral-800/60 hover:border-emerald-500/50 transition-colors group flex flex-col justify-between text-right sm:col-start-2"
          >
            <span class="text-[11px] font-mono text-neutral-600 dark:text-neutral-400 mb-1">
              {strings.blog.nextPost} &rarr;
            </span>
            <span class="text-sm font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-1">
              {nextPostLink.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
