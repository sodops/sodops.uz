---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { strings } from '../../lib/strings';
import { getPublishedPosts } from '../../lib/db';

// Required: On-demand rendering with Cloudflare edge caching
export const prerender = false;

// Edge cache tags for group invalidation on post save
Astro.cache.set({ maxAge: 60, swr: 300, tags: ['blog'] });

import { env } from 'cloudflare:workers';

let posts: Array<{
  slug: string;
  title: string;
  published_at: Date;
  excerpt: string;
  tags: string[];
  reading_time_minutes: number;
}> = [];

// 1. Primary: Load published posts from Cloudflare D1
if (env?.DB) {
  const d1Posts = await getPublishedPosts(env.DB);
  if (d1Posts.length > 0) {
    posts = d1Posts.map((p) => ({
      slug: p.slug,
      title: p.title,
      published_at: new Date(p.published_at || p.created_at),
      excerpt: p.excerpt,
      tags: p.tags,
      reading_time_minutes: p.reading_time_minutes,
    }));
  }
}

// 2. Fallback: If D1 has no published posts yet, read from Content Collections
if (posts.length === 0) {
  const collectionPosts = await getCollection('posts', ({ data }) => !data.draft);
  posts = collectionPosts.map((p) => ({
    slug: p.data.slug,
    title: p.data.title,
    published_at: p.data.published_at,
    excerpt: p.data.excerpt,
    tags: p.data.tags,
    reading_time_minutes: p.data.reading_time_minutes,
  }));
}

// Sort posts by published_at descending
const sortedPosts = posts.sort(
  (a, b) => b.published_at.getTime() - a.published_at.getTime()
);

// Collect all unique tags and post counts
const tagCounts = new Map<string, number>();
for (const post of sortedPosts) {
  for (const tag of post.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}
const allTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);

// Query-param based tag filter: ?tag=k3s
const selectedTag = Astro.url.searchParams.get('tag');
const filteredPosts = selectedTag
  ? sortedPosts.filter((post) => post.tags.includes(selectedTag))
  : sortedPosts;

function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}
---

<BaseLayout
  title={selectedTag ? `${strings.blog.title} (#${selectedTag})` : strings.blog.title}
  description={strings.blog.description}
>
  <div class="space-y-8">
    <!-- Page Header -->
    <header class="space-y-2">
      <h1
        class="text-2xl sm:text-3xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-sans"
      >
        {strings.blog.title}
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        {strings.blog.description}
      </p>
    </header>

    <!-- Tag Filter Bar -->
    {
      allTags.length > 0 && (
        <section aria-label="Filter by tag" class="pt-1">
          <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono">
            <span class="text-neutral-400 dark:text-neutral-500 mr-1">Tags:</span>
            <a
              href="/blog"
              class:list={[
                'px-2 py-0.5 rounded transition-colors',
                !selectedTag
                  ? 'bg-emerald-600 text-white dark:bg-emerald-500 dark:text-neutral-950 font-medium'
                  : 'bg-neutral-100 dark:bg-neutral-800/80 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-200',
              ]}
            >
              all ({sortedPosts.length})
            </a>
            {allTags.map(([tag, count]) => {
              const isActive = selectedTag === tag;
              return (
                <a
                  href={isActive ? '/blog' : `/blog?tag=${encodeURIComponent(tag)}`}
                  class:list={[
                    'px-2 py-0.5 rounded transition-colors',
                    isActive
                      ? 'bg-emerald-600 text-white dark:bg-emerald-500 dark:text-neutral-950 font-medium'
                      : 'bg-neutral-100 dark:bg-neutral-800/80 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-200',
                  ]}
                >
                  #{tag} ({count})
                </a>
              );
            })}
          </div>

          {selectedTag && (
            <div class="mt-3 flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <span>
                Filtered by tag:{' '}
                <strong class="text-neutral-900 dark:text-neutral-100">
                  #{selectedTag}
                </strong>
              </span>
              <span>&middot;</span>
              <a
                href="/blog"
                class="text-emerald-600 dark:text-emerald-400 hover:underline"
              >
                Clear filter &times;
              </a>
            </div>
          )}
        </section>
      )
    }

    <!-- Divider -->
    <hr class="border-neutral-200/60 dark:border-neutral-800/60" />

    <!-- Posts List -->
    <section class="space-y-6">
      {
        filteredPosts.length === 0 ? (
          <p class="text-sm text-neutral-500 dark:text-neutral-400 py-8">
            {strings.blog.noPostsYet}
          </p>
        ) : (
          <div class="space-y-6">
            {filteredPosts.map((post) => (
              <article class="group relative flex flex-col space-y-1.5">
                <div class="flex items-baseline justify-between gap-4">
                  <a
                    href={`/blog/${post.slug}`}
                    class="text-base font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors"
                  >
                    {post.title}
                  </a>
                  <div class="flex items-center gap-2 shrink-0 text-xs font-mono text-neutral-400 dark:text-neutral-500">
                    <time datetime={post.published_at.toISOString()}>
                      {formatDate(post.published_at)}
                    </time>
                  </div>
                </div>

                <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed line-clamp-2">
                  {post.excerpt}
                </p>

                <div class="flex items-center gap-3 pt-1 text-[11px] font-mono text-neutral-500 dark:text-neutral-500">
                  <span>
                    {post.reading_time_minutes} {strings.blog.readingTime}
                  </span>
                  <span>&middot;</span>
                  <div class="flex flex-wrap gap-1.5">
                    {post.tags.map((tag) => (
                      <a
                        href={`/blog?tag=${encodeURIComponent(tag)}`}
                        class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
                      >
                        #{tag}
                      </a>
                    ))}
                  </div>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>
