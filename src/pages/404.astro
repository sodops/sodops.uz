---
import BaseLayout from '../layouts/BaseLayout.astro';
import { strings } from '../lib/strings';

export const prerender = true;
---

<BaseLayout
  title="404 - Page Not Found"
  description="The page you are looking for could not be found."
>
  <div class="py-16 sm:py-24 text-center space-y-6">
    <div class="font-mono text-4xl sm:text-6xl font-bold text-neutral-400 dark:text-neutral-600">
      404
    </div>
    
    <div class="space-y-2">
      <h1 class="text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 font-sans">
        Page Not Found
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 max-w-sm mx-auto font-sans">
        The URL you requested does not exist or has been moved.
      </p>
    </div>

    <div class="pt-4 flex flex-wrap items-center justify-center gap-4 text-xs font-mono">
      <a
        href="/"
        class="px-3.5 py-1.5 rounded bg-neutral-900 text-neutral-100 dark:bg-neutral-100 dark:text-neutral-900 font-medium hover:opacity-90 transition-opacity"
      >
        {strings.common.backHome}
      </a>
      <a
        href="/blog"
        class="px-3.5 py-1.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors"
      >
        Browse Blog
      </a>
      <button
        type="button"
        id="error-search-trigger"
        class="px-3.5 py-1.5 rounded border border-neutral-200 dark:border-neutral-800 text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors cursor-pointer"
        onclick="window.dispatchEvent(new CustomEvent('open-command-palette'))"
      >
        Search site (Ctrl+K)
      </button>
    </div>
  </div>
</BaseLayout>
