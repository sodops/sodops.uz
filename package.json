{
  "name": "sodops.uz",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-csp-hashes.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "npx --yes tsx --test src/lib/*.test.ts",
    "test:e2e": "npx astro preview && npx playwright test && npx astro preview stop",
    "qa": "node scripts/qa/run-all.mjs",
    "qa:prod": "node scripts/qa/run-prod.mjs",
    "todos": "node scripts/list-todos.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate-posts": "npx --yes tsx scripts/migrate-posts-to-d1.ts",
    "deploy:preview": "npx --yes wrangler pages deploy dist --project-name sodops-uz"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/preact": "^6.1.0",
    "@astrojs/rss": "^4.0.19",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "highlight.js": "^11.12.0",
    "preact": "^11.0.1",
    "rehype-highlight": "^7.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.4",
    "@typescript-eslint/parser": "^8.71.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.20.1",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.5.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
